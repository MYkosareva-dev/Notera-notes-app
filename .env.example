# Copy this file to .env.local and fill in the values.
# Both values live in the Supabase dashboard:
#   Project → Settings → API
#     - "Project URL"      → NEXT_PUBLIC_SUPABASE_URL
#     - "anon public" key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# NEVER put the service-role key here or anywhere else in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenRouter (AI model calls) -------------------------------------------------------
# One key, for server-side model calls only. Create it at
# https://openrouter.ai/settings/keys
#
# NOTE THE MISSING PREFIX, and do not add one. This is the opposite case to the two vars
# above: those are NEXT_PUBLIC_* because a browser genuinely needs them and the value they
# hold is low-privilege. This one is a SECRET — it spends real credit — so it must stay off
# every NEXT_PUBLIC_ name. Next inlines every NEXT_PUBLIC_* value textually into the
# browser bundle, so a key pasted under such a name is a working, billable credential
# published to anyone who views source, and the app would boot and answer correctly the
# whole time.
#
# Three things enforce that, in increasing order of how hard they are to bypass:
#   - lib/openrouter/env.ts refuses at boot any NEXT_PUBLIC_* var named for this key or
#     holding a value that looks like one
#   - both modules in lib/openrouter/ import `server-only`, so the BUILD fails if a
#     Client Component imports either one
#   - `npm run check` scans every code file this repo ships for both spellings
#
# `npm run verify:openrouter` proves the key works without ever printing it.
# The key's own prefix is deliberately not written out anywhere in this file: `npm run
# check` scans this template for exactly that string, so an example value would be the
# first thing it found.
OPENROUTER_API_KEY=
