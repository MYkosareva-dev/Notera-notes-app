# dependencies / build
/node_modules/
/.next/
/out/

# generated by Next / TypeScript on every dev run
/next-env.d.ts
/*.tsbuildinfo

# environment — never commit secrets.
# Covers every filename Next.js loads (.env, .env.local, .env.production, ...),
# not just *.local; the committed template is re-included explicitly.
/.env
/.env.*
!/.env.example

# private working files
/WORKLOG.md

# OS / editor junk
.DS_Store

# end-to-end tests (Playwright). Root-anchored, rule 12.
# /e2e/.auth/ holds a LIVE Supabase session captured by `npm run e2e:auth` — never commit it.
/e2e/.auth/
/test-results/
/playwright-report/
